{
	"name": "GreenPeas Dev Container",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// Host: nvidia-ctk >= 1.18. Use --runtime=nvidia so CDI injects GPUs
	"runArgs": [
		"--runtime=nvidia",
		"--gpus",
		"all"
	],
	"hostRequirements": {
		"gpu": "optional"
	},
	"remoteUser": "vscode",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"ms-python.python",
				"ms-python.vscode-pylance"
			],
			"settings": {
				"cmake.configureOnOpen": false,
				"python.defaultInterpreterPath": "/usr/bin/python3"
			}
		}
	},
	"mounts": [
  		"source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind"
	]
}
